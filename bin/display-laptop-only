#!/bin/sh
# Force laptop/internal panel only. Use after hot-unplugging external display.
#   display-laptop-only                always recover (+ single-display OSD)
#   display-laptop-only --if-needed    only when mirror/extend/ghost CRTC
#   display-laptop-only --if-needed --quiet
#       same, but no OSD (caller already showed one, e.g. mirror-toggle none)
set -e

case "$0" in
*/*) here="${0%/*}" ;;
*) here=$( command -v "$0" ) && here="${here%/*}" || here=. ;;
esac
. "$here/../libexec/bhotkeys/display-randr-common.subr"

MODE=force
QUIET=
for _arg in "$@"; do
	case "$_arg" in
	--if-needed) MODE=--if-needed ;;
	--quiet)     QUIET=1 ;;
	''|force)    ;;
	*)
		echo "usage: display-laptop-only [--if-needed] [--quiet]" >&2
		exit 2
		;;
	esac
done

mirror_osd() {
	[ -n "$QUIET" ] && return 0
	if [ -x "/usr/local/bin/display-mirror-osd" ]; then
		"/usr/local/bin/display-mirror-osd" "$1" "${2:-5}" &
	fi
}

needs_recovery() {
	_primary=$1
	_connected=$(display_list_externals "$_primary")

	# Hot-unplug or active extend/mirror left behind: recover if state
	# files remain or an external CRTC is still programmed (incl. ghosts)
	[ -f "$STATE_MIRROR" ] && return 0
	[ -f "$STATE_EXTEND" ] && return 0
	display_externals_active "$_primary" && return 0

	# Ghost framebuffer: outputs may still be "connected" (cable in) but
	# inactive in arandr while Screen 0 stays at the old extend size.
	# That inflates FVWM's page size past the laptop panel
	_need=$(display_active_framebuffer_size)
	_have=$(display_screen_size)
	[ "$_need" ] && [ "$_have" ] && [ "$_need" != "$_have" ] && return 0

	# No plugged externals, but Screen wider than the panel
	if [ ! "$_connected" ]; then
		_sw=$(display_screen_width)
		_pw=$(display_primary_width "$_primary")
		[ "$_sw" ] && [ "$_pw" ] && [ "$_sw" -gt "$_pw" ] && return 0
	fi
	return 1
}

display_xrandr_cache || {
	display_log "display-laptop-only: xrandr --query failed"
	exit 1
}

_primary=$(display_pick_primary)
if [ -z "$_primary" ]; then
	display_log "display-laptop-only: no internal output"
	exit 1
fi

if [ "$MODE" = "--if-needed" ] && ! needs_recovery "$_primary"; then
	exit 0
fi

# Menu "Use Laptop Display Only" always shows the single-display OSD for
# feedback, even when already laptop-only.  Hotplug (--if-needed) shows it
# when we actually recover (unless --quiet).
mirror_osd off 3

_before=$(display_layout_fingerprint "$_primary")
_externals=$(display_list_all_externals "$_primary")
_geom=$(display_output_geometry "$_primary")
_mode=$(display_output_current_mode "$_primary")
_cmd=$XRANDR
_changed=
# Reprogram the panel only when it is not already at origin with a mode.
case "$_geom" in
*x*+0+0)
	: # leave eDP CRTC alone
	;;
*)
	if [ -n "$_mode" ]; then
		_cmd="$_cmd --output $_primary --primary --mode $_mode --pos 0x0"
	else
		_cmd="$_cmd --output $_primary --primary --auto --pos 0x0"
	fi
	_changed=1
	;;
esac
for _out in $_externals; do
	# Disable any programmed CRTC — including disconnected hot-unplug ghosts
	# (geometry is now reported for those; previously we skipped them).
	case "$(display_output_geometry "$_out")" in
	'') ;;
	*)
		_cmd="$_cmd --output $_out --off"
		_changed=1
		;;
	esac
done
if [ -n "$_changed" ]; then
	display_log "LAPTOP-ONLY: $_cmd"
	# shellcheck disable=SC2086
	display_xrandr_apply $_cmd
else
	display_log "LAPTOP-ONLY: already laptop-only (primary=$_primary)"
fi
# --off does not always shrink Screen 0; force FB to the active CRTC box
display_xrandr_cache || true
display_normalize_framebuffer || true
display_clear_modes
display_mode_set laptop
# Same-res mirror off keeps layout; desk/extend recovery still refreshes chrome.
display_fvwm_refresh_after "$_before" "$_primary"
display_log "display-laptop-only complete (primary=$_primary)"

exit 0
