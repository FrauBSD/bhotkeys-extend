############################################################ IDENT(1)
#
# $Title: Extend the laptop panel to external outputs $
# $Copyright: 2026 Devin Teske. All rights reserved. $
# $FrauBSD: bhotkeys-extend/bin/display-extend 2026-10-03 20:58:44 -0700 Devin Teske $
#
############################################################ INFORMATION
#
# Extend the internal panel to connected external outputs
# (HDMI, DP, USB-C). Any connected non-internal RandR output
# is used.
#
#   display-extend --right            external to the right (default)
#   display-extend --left             external to the left
#   display-extend --above            external above the laptop
#   display-extend --off              laptop display only
#   display-extend --toggle           extend right, or laptop-only
#                                     if already extended
#   display-extend --right --quiet    apply without OSD (session restore)
#
############################################################ GLOBALS

pgm="${0##*/}" # Program basename

case "$0" in
*/*) here="${0%/*}" ;;
*) here=$( command -v "$0" ) && here="${here%/*}" || here=. ;;
esac
. "$here/../libexec/bhotkeys/display-randr-common.subr"

POSITION=
QUIET=
TOGGLE=

############################################################ FUNCTIONS

usage()
{
	echo "Usage: $pgm --right|--left|--above|--off|--toggle [--quiet]" >&2
	exit 2
}

extend_osd()
{
	local name="$1" secs="${2:-5}"
	local glyph=

	[ "$QUIET" ] && return 0
	case "$name" in
	extend) glyph=mirror-extend ;;
	extend-none) glyph=mirror-extend-none ;;
	*) return 0
	esac
	have bosd || return 0
	bosd "$glyph" "$secs" &
}

extend_on()
{
	local primary="$1" externals="$2" pos="$3"
	local cmd="$XRANDR" prev= out= first=

	case "$pos" in
	right)
		cmd="$cmd --output $primary --primary --auto --pos 0x0"
		prev="$primary"
		for out in $externals; do
			cmd="$cmd --output $out --auto --right-of $prev"
			prev="$out"
		done
		;;
	left)
		for out in $externals; do
			if [ ! "$prev" ]; then
				cmd="$cmd --output $out --auto --pos 0x0"
			else
				cmd="$cmd --output $out --auto --right-of $prev"
			fi
			prev="$out"
		done
		cmd="$cmd --output $primary --primary --auto --right-of $prev"
		;;
	above)
		for out in $externals; do
			if [ ! "$first" ]; then
				first="$out"
				cmd="$cmd --output $out --auto --pos 0x0"
				prev="$out"
			else
				cmd="$cmd --output $out --auto --right-of $prev"
				prev="$out"
			fi
		done
		cmd="$cmd --output $primary --primary --auto --below $first"
		;;
	esac

	display_log "EXTEND $pos: $cmd"
	display_xrandr_apply $cmd
	mkdir -p "${STATE_EXTEND%/*}"
	printf '%s\n' "$pos" > "$STATE_EXTEND"
	display_clear_mirror
	display_mode_set "extend:${pos}"
	display_fvwm_refresh --if-needed
}

############################################################ MAIN

set -e

for arg in "$@"; do
	case "$arg" in
	--right) POSITION=right ;;
	--left) POSITION=left ;;
	--above) POSITION=above ;;
	--off) exec "${0%/*}/display-laptop-only" ;;
	--toggle) TOGGLE=1; POSITION="${POSITION:-right}" ;;
	--quiet) QUIET=1 ;;
	'') : ok ;;
	*) usage
	esac
done

[ "$POSITION" ] || usage

display_xrandr_cache || {
	display_log "display-extend: xrandr --query failed"
	exit 1
}

primary=$( display_pick_primary )
if [ ! "$primary" ]; then
	display_log "display-extend: no internal output"
	exit 1
fi

# Super+E toggle: leave extend for single-display OSD and laptop-only
if [ "$TOGGLE" ] && display_is_extended "$primary"; then
	display_log "display-extend --toggle: already extended; laptop-only"
	if [ "$QUIET" ]; then
		exec "${0%/*}/display-laptop-only" --quiet
	fi
	exec "${0%/*}/display-laptop-only"
fi

externals=$( display_sort_externals "$( display_list_externals "$primary" )" )
if [ ! "$externals" ]; then
	display_log "display-extend: no external outputs connected" \
		"(primary=$primary)"
	# Red extend glyph; stay laptop-only, do not touch xrandr
	extend_osd extend-none 3
	exit 0
fi

extend_osd extend
extend_on "$primary" "$externals" "$POSITION"
display_log "display-extend enabled $POSITION: $primary + $externals"

exit 0

################################################################################
# END
################################################################################
