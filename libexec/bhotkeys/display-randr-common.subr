#!/bin/sh
# Shared RandR helpers for display-mirror-toggle, display-extend, display-laptop-only.
# Sourced from ${PREFIX}/libexec/bhotkeys/display-randr-common.subr

case "$0" in
*.subr) exit 0 ;;
esac

DISPLAY=${DISPLAY:-:0}
export DISPLAY

STATE_MIRROR=${STATE_MIRROR:-$HOME/.cache/display-mirror-on}
STATE_EXTEND=${STATE_EXTEND:-$HOME/.cache/display-extend-on}
# Last chosen display mode across logout/login:
#   laptop | mirror | extend:left|right|above | layout
STATE_MODE=${STATE_MODE:-$HOME/.cache/display-mode}
LOG=${DISPLAY_LOG:-/tmp/display-randr.log}

XRANDR=$(command -v xrandr) || {
	printf '%s xrandr missing\n' "$(date '+%Y-%m-%d %H:%M:%S')" >> "$LOG"
	exit 1
}

# Cached `xrandr --query` — each live query is ~1s on this hardware.
# Must be filled in the parent shell: `$(helper)` subshells inherit the
# cache for reads but cannot publish a new cache back to the parent.
_DISPLAY_XRANDR_Q=

display_log() {
	printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG"
}

display_xrandr_invalidate() {
	_DISPLAY_XRANDR_Q=
}

# Warm/refresh the query cache in the current shell (not inside $()).
display_xrandr_cache() {
	_DISPLAY_XRANDR_Q=$($XRANDR --query) || return 1
}

display_xrandr_q() {
	if [ -z "$_DISPLAY_XRANDR_Q" ]; then
		display_xrandr_cache || return 1
	fi
	printf '%s\n' "$_DISPLAY_XRANDR_Q"
}

# Run an xrandr configure command and drop the query cache.
display_xrandr_apply() {
	display_log "XRANDR: $*"
	# shellcheck disable=SC2068
	$@ || {
		display_xrandr_invalidate
		return 1
	}
	display_xrandr_invalidate
}

display_output_rank() {
	case "$1" in
	DP-*)   printf '1\n' ;;
	HDMI-*) printf '2\n' ;;
	HDMI*)  printf '3\n' ;;
	VGA-*)  printf '4\n' ;;
	DVI-*)  printf '5\n' ;;
	*)      printf '9\n' ;;
	esac
}

display_pick_primary() {
	display_xrandr_q | awk '
		/^[^ ]/ {
			split($1, a, "+")
			name = a[1]
			state = $2
			if (state != "connected") next
			if (name ~ /^(eDP|LVDS|DSI)-/) { print name; exit }
			if ($3 == "primary") pri = name
		}
		END { if (pri != "") print pri }
	'
}

display_list_externals() {
	_primary=$1
	display_xrandr_q | awk -v pri="$_primary" '
		/^[^ ]/ {
			split($1, a, "+")
			name = a[1]
			if ($2 != "connected") next
			if (name == pri) next
			if (name ~ /^(eDP|LVDS|DSI)-/) next
			print name
		}
	'
}

display_list_all_externals() {
	_primary=$1
	display_xrandr_q | awk -v pri="$_primary" '
		/^[^ ]/ {
			split($1, a, "+")
			name = a[1]
			# "Screen 0:" is a summary line, not an output
			if (name == "Screen") next
			if (name ~ /^(eDP|LVDS|DSI)-/) next
			if (name == pri) next
			print name
		}
	'
}

display_externals_active() {
	_primary=$1
	# Any non-panel output with a programmed CRTC — connected or a
	# disconnected hot-unplug ghost still holding 1920x1200+0+0.
	display_xrandr_q | awk -v pri="$_primary" '
		/^[^ ]/ {
			split($1, a, "+")
			name = a[1]
			if (name == "Screen") next
			if (name == pri) next
			if (name ~ /^(eDP|LVDS|DSI)-/) next
			for (i = 2; i <= NF; i++)
				if ($i ~ /^[0-9]+x[0-9]+\+[0-9]+\+[0-9]+/) {
					active = 1
					break
				}
		}
		END { exit(active ? 0 : 1) }
	'
}

display_sort_externals() {
	_externals=$1
	_sorted=
	for _out in $_externals; do
		_rank=$(display_output_rank "$_out")
		_sorted="$_sorted
$_rank:$_out"
	done
	printf '%s\n' "$_sorted" | sort -n | cut -d: -f2- | sed '/^$/d'
}

display_screen_width() {
	display_xrandr_q | awk '/^Screen 0/ {
		for (i = 1; i <= NF; i++)
			if ($i == "current") {
				print $(i + 1)
				exit
			}
	}'
}

# Active CRTC geometry token: WIDTHxHEIGHT+X+Y (skips the "primary" keyword).
# Includes disconnected outputs that still have a programmed CRTC (hot-unplug
# ghosts) — those must be --off'd or they block reconnect / confuse toggle.
display_output_geometry() {
	_out=$1
	display_xrandr_q | awk -v o="$_out" '
		$1 == o {
			for (i = 2; i <= NF; i++)
				if ($i ~ /^[0-9]+x[0-9]+\+[0-9]+\+[0-9]+/) {
					print $i
					exit
				}
		}
	'
}

display_primary_width() {
	_geom=$(display_output_geometry "$1")
	[ -n "$_geom" ] || return 1
	_wh=${_geom%%+*}
	printf '%s\n' "${_wh%x*}"
}

# Current mode marked with * under an output, e.g. 1920x1200.
display_output_current_mode() {
	_out=$1
	display_xrandr_q | awk -v o="$_out" '
		$1 == o { want = 1; next }
		want && /^[^[:space:]]/ { exit }
		want && $1 ~ /^[0-9]+x[0-9]+/ && index($0, "*") {
			print $1
			exit
		}
	'
}

display_output_has_mode() {
	_out=$1
	_mode=$2
	display_xrandr_q | awk -v o="$_out" -v m="$_mode" '
		$1 == o { want = 1; next }
		want && /^[^[:space:]]/ { exit }
		want && $1 == m { found = 1; exit }
		END { exit(found ? 0 : 1) }
	'
}

# Primary panel origin as "X Y" for Conky placement.
display_primary_origin() {
	_geom=$(display_output_geometry "$1")
	[ -n "$_geom" ] || return 1
	_rest=${_geom#*+}
	_x=${_rest%%+*}
	_y=${_rest#*+}
	printf '%s %s\n' "$_x" "$_y"
}

display_clear_mirror() {
	rm -f "$STATE_MIRROR"
}

display_clear_extend() {
	rm -f "$STATE_EXTEND"
}

display_clear_modes() {
	display_clear_mirror
	display_clear_extend
}

display_mode_set() {
	mkdir -p "$(dirname "$STATE_MODE")"
	printf '%s\n' "$1" > "$STATE_MODE"
	# Greeter (root) must not leave root-owned mode files in the user cache.
	if [ -n "${MENU_HOTKEYS_GREETER:-}${DISPLAY_GREETER:-}" ] &&
	    [ -n "${FLORENCE_GREETER_USER:-}" ]; then
		chown "${FLORENCE_GREETER_USER}:${FLORENCE_GREETER_USER}" \
			"$STATE_MODE" 2>/dev/null || true
	fi
}

display_mode_get() {
	[ -f "$STATE_MODE" ] && cat "$STATE_MODE" || true
}

# True when we intentionally mirrored (state file) and externals still share
# the primary's origin.  Geometry alone is not enough — a transient --auto
# wake must not look like "already mirroring" and flip straight to mirror_off.
display_is_mirroring() {
	_primary=$1
	[ -f "$STATE_MIRROR" ] || return 1
	_pg=$(display_output_geometry "$_primary")
	[ -n "$_pg" ] || return 1
	_pox=${_pg#*+}
	_pox=${_pox%%+*}
	_poy=${_pg##*+}
	_saw=
	for _out in $(display_list_externals "$_primary"); do
		_og=$(display_output_geometry "$_out")
		[ -n "$_og" ] || continue
		_ox=${_og#*+}
		_ox=${_ox%%+*}
		_oy=${_og##*+}
		[ "$_ox" = "$_pox" ] && [ "$_oy" = "$_poy" ] || return 1
		_saw=1
	done
	[ -n "$_saw" ] || return 1
	return 0
}

# True when some connected external CRTC is active but NOT a same-as clone
# of the primary (arandr / extend desk).
display_is_extended() {
	_primary=$1
	_pg=$(display_output_geometry "$_primary")
	[ -n "$_pg" ] || return 1
	_pox=${_pg#*+}
	_pox=${_pox%%+*}
	_poy=${_pg##*+}
	_saw=
	for _out in $(display_list_externals "$_primary"); do
		_og=$(display_output_geometry "$_out")
		[ -n "$_og" ] || continue
		_saw=1
		_ox=${_og#*+}
		_ox=${_ox%%+*}
		_oy=${_og##*+}
		if [ "$_ox" != "$_pox" ] || [ "$_oy" != "$_poy" ]; then
			return 0
		fi
	done
	[ -n "$_saw" ] || return 1
	return 1
}

# Screen 0 current size as WIDTHxHEIGHT.
display_screen_size() {
	display_xrandr_q | awk '/^Screen 0/ {
		for (i = 1; i <= NF; i++)
			if ($i == "current") {
				w = $(i + 1)
				h = $(i + 3)
				gsub(/,/, "", h)
				print w "x" h
				exit
			}
	}'
}

#
# Bounding box of active CRTCs (outputs with WIDTHxHEIGHT+X+Y), as WxH.
# Used to shrink a leftover framebuffer after arandr/--off leaves Screen
# larger than any lit panel (FVWM then treats that ghost area as one page)
#
display_active_framebuffer_size() {
	display_xrandr_q | awk '
		/ connected/ {
			for (i = 1; i <= NF; i++) {
				if ($i ~ /^[0-9]+x[0-9]+\+[0-9]+\+[0-9]+$/) {
					split($i, a, /[x+]/)
					r = a[3] + a[1]
					b = a[4] + a[2]
					if (r > maxx) maxx = r
					if (b > maxy) maxy = b
				}
			}
		}
		END {
			if (maxx > 0 && maxy > 0)
				print maxx "x" maxy
		}
	'
}

#
# Match Screen 0 to the active-CRTC bounding box.  xrandr --output … --off
# often leaves the previous extend/mirror framebuffer intact
#
display_normalize_framebuffer() {
	_need=$(display_active_framebuffer_size) || return 0
	[ "$_need" ] || return 0
	_have=$(display_screen_size)
	[ "$_have" ] || return 0
	[ "$_need" = "$_have" ] && return 0
	display_log "framebuffer normalize $_have -> $_need"
	# shellcheck disable=SC2086
	display_xrandr_apply $XRANDR --fb "$_need"
}

# Fingerprint of chrome-relevant layout: virtual screen + primary CRTC.
# Same-resolution mirror on/off keeps this stable; extend/desk layouts do not.
display_layout_fingerprint() {
	_pri=$1
	_screen=$(display_screen_size)
	_geom=$(display_output_geometry "$_pri")
	printf '%s|%s\n' "${_screen:-}" "${_geom:-}"
}

# Remap touch/pen CTM to the current RandR layout. Stale matrices from a
# previous extend/arandr desk leave the cursor offset from the finger.
# Skip gesture warm-restart: that is for S3 resume, not modesets — and
# killing touchscreen-gestures used to inject Escape into the focused app.
display_input_apply() {
	if [ -x "/usr/local/bin/framework-input-apply" ]; then
		FRAMEWORK_INPUT_NO_GESTURE_WARM=1 \
		    "/usr/local/bin/framework-input-apply" >> "$LOG" 2>&1 || \
			display_log "framework-input-apply failed"
	fi
}

# FVWM3 RandR handling can reset desk.pages to 1x1 even when the virtual
# screen size is unchanged (same-res mirror).  Re-assert the configured grid
# without rebuilding taskbar/pager chrome.
display_fvwm_assert_desktop_size() {
	_dx=${PAGER_DESK_X:-3}
	_dy=${PAGER_DESK_Y:-3}
	_sock=${FVWMMFL_SOCKET:-/tmp/fvwmmfl/fvwm_mfl_${DISPLAY:-:0}.sock}
	_sock_alt=/tmp/fvwmmfl/fvwm_mfl_:0.sock
	if [ ! -S "$_sock" ]; then
		_sock=$_sock_alt
	fi
	if [ -S "$_sock" ] && command -v FvwmCommand >/dev/null 2>&1; then
		FvwmCommand -f "$_sock" "DesktopSize ${_dx}x${_dy}" >> "$LOG" 2>&1 || \
			display_log "DesktopSize ${_dx}x${_dy} failed"
		display_log "assert DesktopSize ${_dx}x${_dy}"
	else
		display_log "FvwmMFL missing; cannot assert DesktopSize"
	fi
}

display_fvwm_refresh() {
	# Shrink ghost framebuffers before chrome reads geometry (arandr --off
	# and laptop-only often leave Screen larger than any active CRTC)
	display_xrandr_cache || true
	display_normalize_framebuffer || true
	# Session bring-up defers the first chrome map to fvwm-deferred-chrome
	# so FvwmPager is never auto-sized, then corrected.
	if [ -n "${FVWM_DEFER_CHROME:-}" ]; then
		display_log "fvwm chrome deferred (FVWM_DEFER_CHROME set)"
		display_input_apply
		return 0
	fi
	if [ -x "/usr/local/bin/fvwm-refresh-display-chrome" ]; then
		"/usr/local/bin/fvwm-refresh-display-chrome" "$@" >> "$LOG" 2>&1 || \
			display_log "fvwm-refresh-display-chrome failed"
	fi
	display_input_apply
}

# After RandR: rebuild FVWM chrome only when the virtual screen or primary
# CRTC geometry changed. Same-res mirror toggles take the fast path.
display_fvwm_refresh_after() {
	_before=$1
	_primary=$2
	# RandR can briefly report an empty layout right after outputs go
	# --off; wait for a stable fingerprint before deciding.
	_after=
	_try=0
	while [ "$_try" -lt 8 ]; do
		display_xrandr_invalidate
		display_xrandr_cache || true
		_after=$(display_layout_fingerprint "$_primary")
		case "$_after" in
		''|'|'|*'|')
			_try=$((_try + 1))
			sleep 0.25
			continue
			;;
		esac
		break
	done
	if [ -z "$_after" ] || [ "$_after" = "|" ]; then
		display_log "layout fingerprint still empty after wait; force fvwm chrome refresh"
		display_fvwm_refresh
		return 0
	fi
	if [ -n "$_before" ] && [ "$_before" = "$_after" ]; then
		display_log "layout unchanged (${_after}); skip fvwm chrome refresh"
		# Still remap touch: CTM can be stale even when geometry matches
		# (e.g. mode flag cleared without a CRTC move).
		display_fvwm_assert_desktop_size
		display_input_apply
		return 0
	fi
	display_log "layout changed (${_before:-none} -> ${_after}); refresh fvwm chrome"
	display_fvwm_refresh --if-needed
}

display_extend_position() {
	[ -f "$STATE_EXTEND" ] && cat "$STATE_EXTEND" || true
}
